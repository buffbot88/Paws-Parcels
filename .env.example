# Paws & Parcels — client build environment variables
# Copy this to .env and fill in for production builds.
# These are embedded at build time by Vite (vite.config.ts define).

# Absolute URL of the game server (Omega). Leave empty for same-origin
# (single-process hosting). Example: VITE_GAME_SERVER_URL=https://ashatneuralhost.agpstudios.org
VITE_GAME_SERVER_URL=

# Maintenance mode. When "true" (the default), the client shows a
# "game server offline" screen after login instead of booting the game.
# Set to "false" to enable the game when Omega is ready.
VITE_MAINTENANCE=true
