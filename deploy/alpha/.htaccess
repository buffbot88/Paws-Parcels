# Paws & Parcels — Apache config for Alpha (static client hosting)
# Drop this .htaccess into the DocumentRoot alongside the built dist/ files.
# Enables SPA-style routing: any path that isn't a real file falls through
# to index.html so the client-side router handles it.

RewriteEngine On

# If the request is for an existing file or directory, serve it directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else → index.html (SPA fallback).
RewriteRule ^ index.html [L]

# Cache hashed assets (Vite outputs /static/*.js, /static/*.css with content
# hashes — assetsDir is "static" because the ASHAT Hub server config globally
# aliases /assets/ to the Hub's public dir on every vhost) for a year.
# index.html and client-version.txt are entry/update metadata and stay fresh.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/json "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security headers.
<IfModule mod_headers.c>
  <FilesMatch "^(index\\.html|client-version\\.txt)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
