{
  "name": "paws-and-parcels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Paws & Parcels — cozy browser-based 2.5D online RPG (server-authoritative, SQLite-backed, multiplayer).",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build && node scripts/write-client-version.mjs && node -e \"require('node:fs').copyFileSync('deploy/alpha/.htaccess','dist/.htaccess')\"",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "dev:server": "node --import tsx server/src/index.ts",
    "start:server": "node --import tsx server/src/index.ts",
    "migrate": "node --import tsx server/src/db/migrate.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "validate": "node scripts/validate-content.ts",
    "verify": "npm run typecheck && npm test && npm run validate && npm run build",
    "assets:inventory": "node scripts/inventory-assets.mjs",
    "assets:catalog": "node \"Asset Catalog/build-standalone.mjs\"",
    "assets:browse": "node scripts/build-browse-assets.mjs",
    "tiles:render": "node --import tsx scripts/render-tiles.mjs",
    "tiles:review": "node --import tsx scripts/ai-tile-review.mjs",
    "tiles:loop": "node --import tsx scripts/render-tiles.mjs && node --import tsx scripts/ai-tile-review.mjs",
    "tiles:tune": "node --import tsx scripts/auto-tune-tiles.mjs",
    "visual:review": "node --import tsx scripts/visual-director.mjs",
    "visual:latest": "node --import tsx scripts/visual-latest.mjs",
    "visual:history": "node --import tsx scripts/visual-history.mjs"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.0",
    "phaser": "^4.2.1",
    "tsx": "^4.19.0",
    "uuid": "^11.1.0",
    "ws": "^8.21.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
